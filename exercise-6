// ========================================
// 3. Use concat()
// ========================================

// concat() combines two arrays.
//
// inventory1 + inventory2
// = one big inventory

var inventory = inventory1.concat(inventory2);

console.log("Complete inventory:");
console.log(inventory);


// ========================================
// 4. Use sort() to order by price
// ========================================

// sort() normally sorts alphabetically.
//
// We use a function to sort by price.
//
// a.price - b.price
// = lowest price to highest price

inventory.sort(function(a, b) {

    return a.price - b.price;

});

console.log("Products sorted by price:");
console.log(inventory);


// ========================================
// 5. Use includes()
// ========================================

// Create a list of available categories.

var availableCategories = [
    "Electronics",
    "Accessories",
    "Audio",
    "Office"
];


// Check if a category exists.

var categoryExists = availableCategories.includes("Electronics");

console.log("Is Electronics available?");
console.log(categoryExists);


// includes() returns:
// true  → category exists
// false → category does not exist



// ========================================
// 6. Use splice() to remove a product
// ========================================

// Let's say the Mouse is discontinued.
//
// splice() removes items from an array.
//
// First number = starting index
// Second number = number of items to remove

inventory.splice(1, 1);

console.log("After removing discontinued product:");
console.log(inventory);


// ========================================
// 7. Use slice()
// ========================================

// slice() creates a copy of part
// of the array.
//
// 0 = start at the beginning
// 5 = stop before index 5

var firstFiveProducts = inventory.slice(0, 5);

console.log("First five products:");
console.log(firstFiveProducts);


// slice() does NOT remove them
// from the original inventory.


// ========================================
// Final inventory
// ========================================

console.log("Final inventory:");

console.log(inventory);